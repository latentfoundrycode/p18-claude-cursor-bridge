#!/bin/sh
# Bridge windowless and command-reference gate. The bridge has no linter in its manifest, so
# there is no lint command here. This runs CI's windowless check (tests.yml, the "windowless
# check over the bridge's programs" step) and also scans the hook folder .cursor/hooks, then
# runs the command-reference check (dump-cli.py --check); a non-zero result blocks the commit.
# Pre-delegation checkpoint commits bypass this with `git commit --no-verify`
# (they are recovery anchors and must always succeed).
if ! python bridge/cursor-bridge/windowless-check.py bridge/cursor-bridge .cursor/hooks; then
  echo "pre-commit: a subprocess launch is missing the windowless flag (or a 'windowless: visible-ok <reason>' marker). Use --no-verify ONLY for a checkpoint snapshot." 1>&2
  exit 1
fi
if ! python tools/dump-cli.py --check; then
  echo "pre-commit: the command reference is stale; run: python tools/dump-cli.py" 1>&2
  exit 1
fi
