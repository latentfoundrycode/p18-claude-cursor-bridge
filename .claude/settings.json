{
  "permissions": {
    "allow": [
      "Bash(cursor-agent:*)",
      "Bash(python ~/.claude/cursor-bridge/bridge-run.py --limit * -- cursor-agent *)",
      "Bash(python ~/.claude/cursor-bridge/bridge-run.py --limit * -- gh pr checks *)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git grep:*)",
      "Bash(git log:*)",
      "Bash(git rev-parse:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git fetch:*)",
      "Bash(git switch:*)",
      "Bash(git rm:*)",
      "Bash(git revert:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git config core.hooksPath:*)",
      "Bash(git worktree add ../Worktrees/*)",
      "Bash(git worktree remove ../Worktrees/*)",
      "Bash(git worktree prune:*)",
      "Bash(git worktree list:*)",
      "Bash(git merge --no-edit origin/main:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr view:*)",
      "Bash(npx impeccable@*)",
      "Bash(npx --yes impeccable@*)",
      "Bash(semgrep:*)",
      "Bash(osv-scanner:*)",
      "Bash(socket:*)",
      "Bash(pytest --collect-only:*)",
      "Bash(python ~/.claude/cursor-bridge/scope-check.py:*)",
      "Bash(python .cursor/hooks/windowless-check.py:*)",
      "Bash(npx --yes jscpd@*)",
      "Bash(python ~/.claude/cursor-bridge/refactor-check.py:*)",
      "Bash(python ~/.claude/cursor-bridge/bench-check.py:*)",
      "Bash(python ~/.claude/cursor-bridge/lock-check.py:*)",
      "Bash(python ~/.claude/cursor-bridge/roster-check.py:*)",
      "Bash(cat ~/.claude/cursor-bridge/VERSION)",
      "Bash(python ~/.claude/cursor-bridge/bridge-check.py:*)",
      "Bash(python ~/.claude/cursor-bridge/conformance-check.py:*)",
      "Bash(python ~/.claude/cursor-bridge/bridge-install.py:*)",
      "Bash(python ~/.claude/cursor-bridge/sync-check.py:*)",
      "Bash(python ~/.claude/cursor-bridge/inventory-check.py:*)",
      "Bash(python ~/.claude/cursor-bridge/completion-check.py:*)",
      "Bash(python ~/.claude/cursor-bridge/plan-check.py:*)",
      "Bash(python ~/.claude/cursor-bridge/diagram-check.py:*)",
      "Bash(python ~/.claude/cursor-bridge/pr-activity-check.py:*)",
      "Bash(python ~/.claude/cursor-bridge/review-guard.py:*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File ~/.claude/cursor-bridge/installer-check.ps1:*)"
    ],
    "deny": [
      "Bash(*pr merge*--admin*)",
      "Bash(*push*--force*)",
      "Bash(*push* -f *)",
      "Bash(*push* -f)",
      "PowerShell(*pr merge*--admin*)",
      "PowerShell(*push*--force*)",
      "PowerShell(*push* -f *)",
      "PowerShell(*push* -f)",
      "PowerShell(*cursor-agent*)",
      "PowerShell(*bridge-run*)"
    ]
  },
  "retired": [
    "Bash(git worktree add ../Worktrees/:*)",
    "Bash(git worktree remove ../Worktrees/:*)",
    "Bash(npx --yes impeccable:*)",
    "Bash(npx --yes jscpd:*)",
    "Bash(python ~/.claude/cursor-bridge/bridge-run.py:*)"
  ],
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$HOME/.claude/cursor-bridge/loop-guard.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$HOME/.claude/cursor-bridge/permission-guard.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|resume|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$HOME/.claude/cursor-bridge/session-start.py\" --part pointers",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python \"$HOME/.claude/cursor-bridge/session-start.py\" --part digest",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
