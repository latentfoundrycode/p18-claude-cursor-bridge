+    workspace(tmp_path, GATE.replace(OSV, ""))
+    (tmp_path / ".github" / "workflows" / name).write_text(weekly(), encoding="utf-8")
+    assert verdict(run(tmp_path)[1], ROW)[0] == "MISSING"
+
+
