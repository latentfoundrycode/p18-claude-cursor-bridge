+
+# ---------------------------------------------------------------- C36: the pid file at a limit
+
+
+SLEEP = "import time\ntime.sleep(120)\n"
+
+
+def sleeper(lab, kind):
+    ws, _ = lab
+    if kind == "test":
+        (ws / "tests" / "test_sleep.py").write_text("import time\n\n\ndef test_sleep():\n    time.sleep(120)\n",
