+
+
+def launch(lab, words, kind=None, limit="120", strip=False, allow_any=False, extra=None, timeout=300, flags=()):
+    ws, _ = lab
+    argv = [sys.executable, PROG, "--limit", limit] + (["--strip"] if strip else [])
