+def item(text, number, label):
+    """A numbered item of a procedure list, from `<number>. **<label>**` to the next item."""
+    start = text.index("\n%d. **%s**" % (number, label))
+    end = text.index("\n%d. **" % (number + 1), start)
+    return flat(text[start:end])
+
