+```python
+def _git_rev_parse(folder, *args):
+    try:
+        p = subprocess.run(
+            ["git", "-C", folder or ".", "rev-parse"] + list(args),
+            capture_output=True,
+            text=True,
+            encoding="utf-8",
+            errors="replace",
+            creationflags=NO_WINDOW,
+            timeout=bridge_env.GIT_TIMEOUT,
+        )
+        if p.returncode != 0:
