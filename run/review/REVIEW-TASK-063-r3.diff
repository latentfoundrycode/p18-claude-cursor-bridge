+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    real = mod._clock
+    base = {"t": None}
+
+    def clock():
+        if base["t"] is None:
+            base["t"] = real()
+            return base["t"]
+        return base["t"] + 9
