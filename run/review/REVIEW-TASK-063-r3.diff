+        if glued_amp:
+            last_amp_glued = word_started and not pending
+        if pending and not word_started:
+            refuse("a redirection with no target")
+            return
+        emit_word()
+        if kind == "pipe":
+            finish_cmd("|")
+            piped = True
+        else:
+            finish_chain(kind)
+
+    def start_redirect(at):
