+        if quote == "s":
+            if c == "'":
+                quote = None
+            else:
+                wbuf.append(c)
+                mark()
+            i += 1
+            continue
+        if quote == "d":
+            if c == "\\" and i + 1 < n:
+                nxt = text[i + 1]
+                if nxt in '"\\':
+                    wbuf.append(nxt)
+                    mark()
+                    i += 2
+                    continue
+                if nxt == "\n":
+                    i += 2
+                    continue
+                wbuf.append(c)
+                mark()
+                i += 1
+                continue
+            if c in "$`":
+                refuse("a substitution inside double quotes")
+                break
+            if c == '"':
+                quote = None
+                i += 1
+                continue
+            wbuf.append(c)
+            mark()
+            i += 1
+            continue
+        if c == "\\" and i + 1 < n:
+            nxt = text[i + 1]
+            if nxt == "$":
+                refuse("a command substitution")
+                break
+            if nxt == "`":
+                refuse("a backtick command")
+                break
+            if nxt == "\n":
+                i += 2
+                continue
+            if nxt == "\r":
+                wbuf.append("\r")
+                word_started = True
+                word_backslash = True
+                brace_only = False
+                i += 2
+                continue
+            wbuf.append(nxt)
+            word_started = True
+            word_backslash = True
+            brace_only = False
+            i += 2
+            continue
+        if c == "\\":
+            wbuf.append(c)
+            word_started = True
+            word_backslash = True
+            brace_only = False
+            i += 1
+            continue
+        if c == "`":
+            refuse("a backtick command")
+            break
+        if c == "$":
+            refuse("a command substitution")
+            break
+        if c == "<" and i + 1 < n and text[i + 1] == "(":
+            refuse("process substitution")
+            break
+        if c == ">" and i + 1 < n and text[i + 1] == "(":
