+        elif at == "<":
+            i += 2 if c1 in ">&" else 1
+        elif c1 in ">&|":
+            i += 2
+        else:
+            i += 1
+        pending = True
+        return True
+
+    def mark():
+        nonlocal word_started, brace_only
+        word_started = True
+        brace_only = False
+
+    while i < n:
+        if unreadable:
+            break
+        late, next_check = _deadline_at(i, next_check)
+        if late:
+            refuse("too long to read in time")
+            break
+        if in_comment:
+            if text[i] == "\n":
+                in_comment = False
+                finish_chain("\n")
+            i += 1
+            continue
