+        end = datetime.datetime.fromtimestamp(start_epoch + int(record["limit"]) + int(grace), tz=datetime.timezone.utc)
+        return end.strftime("%Y-%m-%dT%H:%M:%S") + "Z"
+    except (OverflowError, OSError, ValueError):
