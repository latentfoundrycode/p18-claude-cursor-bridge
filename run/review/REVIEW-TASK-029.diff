+            sys.stderr.write(_slot_not_free_line(last_live, grace))
+            sys.stderr.write("bridge-run: exit 123\n")
+            sys.stderr.flush()
+            try:
+                os.close(lock_fd)
+            except OSError:
+                pass
+            return None
