+                        end_epoch = start_epoch + live["limit"] + grace
+                        bound_wall = min(provisional_wall, max(own_floor_wall, end_epoch))
+                        deadline_mono = wait_mono + (bound_wall - wait_wall)
+                    except (OverflowError, OSError, ValueError):
+                        pass
