+def _one_file_root(tmp_path, rel, text):
+    root = tmp_path / "root"
+    (root / "types").mkdir(parents=True)
+    (root / "traits").mkdir()
+    path = root / rel
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(text, encoding="utf-8", newline="\n")
+    return root, str(root).replace("\\", "/") + "/" + rel
+
