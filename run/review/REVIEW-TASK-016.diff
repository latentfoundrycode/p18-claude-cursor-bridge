+def test_r029_a_refused_reference_touches_no_file(tmp_path, monkeypatch):
+    """Security (round 1 FAIL; round 2 advisory A3): the segment rule decides before any file-system call, so a UNC or
+    drive form never reaches the network or another drive. resolve_ref(rest, root) is called in-process with the file
+    system's lookups recording every call."""
+    root = make_repo(tmp_path)
+    program = _load_program()
+    calls = []
+    for name in ("realpath", "exists", "isdir", "isfile", "islink", "lexists", "isjunction"):
+        real = getattr(os.path, name, None)
+        if real is None:
+            continue
+        monkeypatch.setattr(os.path, name, lambda *a, _n=name, _r=real, **k: calls.append(_n) or _r(*a, **k))
+    for name in ("stat", "lstat", "scandir", "listdir"):
+        real = getattr(os, name)
+        monkeypatch.setattr(os, name, lambda *a, _n=name, _r=real, **k: calls.append(_n) or _r(*a, **k))
+    rests = ("\\\\host\\share\\x", "//host/share/x", "C:/Windows", "../README.md", "a/../../x", "cmd/<x>/../..",
+             "commands./supervisor.md", "NUL", "cursor-bridge/com1.md")
+    results = [program.resolve_ref(rest, str(root)) for rest in rests]
+    refused_calls = list(calls)
+    control = program.resolve_ref("commands/supervisor.md", str(root))   # the positive control: the hooks record
+    monkeypatch.undo()
+    assert results == [False] * len(rests) and refused_calls == [], (results, refused_calls)
+    assert control is True and len(calls) > 0, (control, calls)
+
