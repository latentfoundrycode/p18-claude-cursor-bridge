+        print("ERROR: git ls-tree: %s" % escape_field(err))
+        print("RESULT: not checked")
+        return 2
+    if proc.returncode != 0:
+        print("ERROR: git ls-tree: command failed")
+        print("RESULT: not checked")
+        return 2
+    raw = proc.stdout
+    for part in raw.split(b"\0"):
+        if not part:
+            continue
