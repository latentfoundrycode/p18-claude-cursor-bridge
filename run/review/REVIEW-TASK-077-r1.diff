+        return None
+    head = text.split("\r\n\r\n", 1)[0] if "\r\n\r\n" in text else text.split("\n\n", 1)[0]
+    if not head.startswith("HTTP/"):
+        return None
+    m = re.search(r"HTTP/\S+\s+(\d+)", head.split("\r\n", 1)[0].split("\n", 1)[0])
