+        assert has(r"security tab", sec), "%s: the remedy does not name the Security tab:\n%s" % (case, sec)
+    assert not has(r"\bgreen\b", sec), "%s reported green:\n%s" % (case, sec)
+    assert_clean_file(bench, out)
