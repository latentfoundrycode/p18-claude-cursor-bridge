+    rc, out, err = conformance(workspace(tmp_path, text_in))
+    v, text = verdict(out, "Workflows line")
+    assert v == "MISSING" and text.startswith("Workflows line  - malformed: "), out
+    assert reason in text, out
+    assert rc == 1
+
