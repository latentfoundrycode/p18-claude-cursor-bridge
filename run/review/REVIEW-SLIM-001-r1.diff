+def state(repo, files, head=None, base=None, into="main"):
+    return {"head": head or git(repo, "rev-parse", "HEAD"), "base": base or git(repo, "rev-parse", "refs/remotes/origin/main"), "into": into,
+            "files": list(files)}
+
