+    lagging = state(repo, ["docs/PROJECT_STATUS.md"], head="0" * 40)
+    github(lagging, lagging, state(repo, ["docs/PROJECT_STATUS.md"]))
+    rc = mod.cmd_premerge_records(str(repo), "12")
+    out = capsys.readouterr().out
