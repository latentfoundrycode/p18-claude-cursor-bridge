+    rep = Report(section(r.out, p.name))
+    for row in rep.weeks.values():
+        assert rep.cell(row, "tokens") == "", row
+    assert any(p.name in line and ("time" in line.lower() or "limit" in line.lower()) for line in r.both.splitlines()), r
