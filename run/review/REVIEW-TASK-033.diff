+            out_parts.append("# %s\n\n(%s)\n" % (aname, msg))
+            exit_code = 1
+            continue
+        out_parts.append(text)
+
+    sys.stdout.write("".join(out_parts))
+    return exit_code
+
+
+if __name__ == "__main__":
+    sys.exit(main() or 0)
