+def _launcher_rows_during_review_note(root, launched_at):
+    """One stdout line naming launcher rows inside the review's own run, or None (Requirement 4: note only)."""
+    if not launched_at:
+        return None
+    rows = bridge_env.read_runs_jsonl(root)
