+            assert f not in text, "a computer path in the reference: %r" % f
+        assert not re.search(r"(?<![A-Za-z])[A-Za-z]:[\\/]", text), re.search(r"(?<![A-Za-z])[A-Za-z]:[\\/].{0,40}", text).group(0)
