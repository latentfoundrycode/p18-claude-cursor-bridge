+    (folder / "zz_lib.py").write_text(LIBRARY_NEW, encoding="utf-8")
+    (folder / "zz-argp.py").write_text(PROGRAM_ARGP, encoding="utf-8")
+    (folder / "zz-trap.py").write_text(PROGRAM_TRAP, encoding="utf-8")
