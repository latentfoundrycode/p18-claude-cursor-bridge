+def _md_regions(md):
+    """The Markdown's lines outside fenced blocks, with their indexes."""
+    out, fenced = [], False
+    for i, line in enumerate(md.split("\n")):
+        if line.startswith("```"):
+            fenced = not fenced
+            continue
+        if not fenced:
+            out.append((i, line))
+    return out
+
+
+def _fenced(text):
+    return "```\n" + "\n".join(text.splitlines()) + "\n```"
+
