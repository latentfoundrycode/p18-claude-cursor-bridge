+- bridge/cursor-bridge/invisible-check.py
+- bridge/cursor-bridge/MANIFEST.json
+- tests/test_program_invisible.py
+- tests/test_invisible_check.py
+- tests/test_hotfix25a_guard_scope_invisible.py
