+def escape_field(value):
+    text = "" if value is None else str(value)
+    parts = []
+    for char in text:
+        if char.isprintable() and ord(char) < 128:
+            parts.append(char)
+        elif char == "\n":
+            parts.append("\\n")
+        elif char == "\r":
+            parts.append("\\r")
+        elif char == "\t":
+            parts.append("\\t")
+        elif ord(char) < 256:
+            parts.append("\\x%02x" % ord(char))
+        elif ord(char) < 0x10000:
+            parts.append("\\u%04x" % ord(char))
+        else:
+            parts.append("\\U%08x" % ord(char))
+    return "".join(parts)
