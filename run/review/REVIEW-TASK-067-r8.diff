+def _config(s, extra=""):
+    s.gitconfig.write_text("[user]\n\tname = %s\n\temail = %s\n[core]\n\tautocrlf = false\n%s" % (IDENT_NAME, IDENT_MAIL, extra),
+                           encoding="utf-8")
