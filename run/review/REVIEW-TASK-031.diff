+def read_pytest_results(results_path):
+    if not os.path.isfile(results_path):
+        return None
+    try:
+        with open(results_path, encoding="utf-8") as f:
+            data = json.load(f)
+    except (OSError, json.JSONDecodeError):
+        return None
+    if not data.get("session_finished"):
+        return None
+    return data
