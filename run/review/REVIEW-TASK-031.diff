+
+subprocess.run([sys.executable, sys.argv[1], sys.argv[2]], stdin=subprocess.DEVNULL, stdout=sys.stdout.fileno(),
+               stderr=sys.stderr.fileno(), creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0), timeout=60)
+while True:
