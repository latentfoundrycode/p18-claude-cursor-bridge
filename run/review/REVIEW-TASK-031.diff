+    assert "fixtures/leak" in p.stderr.replace("\\", "/"), p.stderr      # the refusal names the link
+    assert _cache_lines(ws, "lnk") == []
+    assert secret.read_text(encoding="utf-8") == "outside the Workspace\n"   # the outside file is untouched
