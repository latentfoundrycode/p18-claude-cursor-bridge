+def lies_in_no_repository(path):
+    p = os.path.abspath(str(path))
+    while True:
+        if os.path.exists(os.path.join(p, ".git")):
+            return False
+        parent = os.path.dirname(p)
+        if parent == p:
+            return True
+        p = parent
