+class GitConfigWatch(object):
+    """Fixed git config paths and hooks folders for before/after reads (test and driver runs)."""
+
+    def __init__(self, folder):
+        self._files = []
+        self._hooks_dirs = []
+        self._parent = None
+        self.active = False
+        try:
+            common = git_common_dir(folder)
+            if not common:
+                return
+            parent = os.path.dirname(common)
