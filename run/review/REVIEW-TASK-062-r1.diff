+                self._files.append((wt_cfg, _git_display_path(wt_cfg, parent)))
+                commondir = os.path.join(git_dir, "commondir")
+                self._files.append((commondir, _git_display_path(commondir, parent)))
+            top = _git_rev_parse(folder, "--show-toplevel")
