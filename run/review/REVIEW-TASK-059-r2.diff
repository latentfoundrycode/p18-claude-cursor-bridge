+def _package_body_index(argv, head):
+    """Index of the subcommand word, skipping listed folder options only."""
+    if head not in PACKAGE_FOLDER_LONG:
+        return 1
+    i = 1
+    while i < len(argv):
+        if argv[i] == "--":
+            return None
+        word = argv[i]
+        if not word.startswith("-"):
+            return i
+        opt = _package_folder_token(head, word)
+        if opt == "attached":
+            return None
+        if opt is not None:
+            if "=" in word:
+                i += 1
+            elif i + 1 < len(argv):
+                i += 2
+            else:
+                return None
+            continue
+        return None
+    return None
