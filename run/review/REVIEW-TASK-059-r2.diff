+def python_interpreter_lead(argv, folder=None):
+    """Where a python command's own words begin after its leading -B and -X utf8, and a refused word if any."""
+    if not argv or head_of(argv) not in ("python", "python3", "py"):
+        return 1, None
+    i, saw_b, saw_x = 1, False, False
+    while i < len(argv):
+        a = argv[i]
+        if a == "-B":
+            if saw_b:
+                return i, "-B"
+            saw_b = True
+            i += 1
+            continue
+        if a == "-X":
+            if i + 1 < len(argv) and argv[i + 1] == "utf8":
+                if saw_x:
+                    return i, "-X"
+                saw_x = True
+                i += 2
+                continue
+            return i, "-X"
+        if a.startswith("-X") and a != "-X":
+            return i, a
+        if a == "-m" and i + 1 < len(argv) and argv[i + 1] in ("pytest", "unittest"):
+            return i, None
+        if a.startswith("-"):
+            return i, a.split("=", 1)[0]
+        return i, None
+    return i, None
+
+
+def _package_folder_token(head, word):
+    """The folder option named by word in an exact listed form, ``attached`` for -C<path>, or None."""
+    if head not in PACKAGE_FOLDER_LONG:
+        return None
+    if head in ("npm", "pnpm") and len(word) > 2 and word.startswith("-C") and not word.startswith("-C="):
+        return "attached"
+    name = word.split("=", 1)[0]
+    if head == "npm" and name in ("--prefix", "-C"):
+        return name
+    if head == "pnpm" and name in ("--dir", "-C"):
+        return name
+    if head == "yarn" and name == "--cwd":
+        return name
+    return None
+
+
+def _package_folder_value(word, argv, i):
+    if "=" in word:
+        return word.split("=", 1)[1], i + 1, word
+    if i + 1 < len(argv):
+        return argv[i + 1], i + 2, word
+    return None, i + 1, word
+
+
+def _package_folder_ok(value, launch_folder):
+    walk_base = launch_folder or os.getcwd()
+    if not (value or "").strip():
+        return False
+    path = value if os.path.isabs(value) else os.path.join(walk_base, value)
+    try:
+        path = os.path.abspath(path)
+    except OSError:
+        return False
+    if not os.path.isdir(path):
+        return False
+    roots = launch_roots(walk_base)
+    full = _real_path(path)
+    if not any(full == r or full.startswith(r.rstrip(os.sep) + os.sep) for r in roots):
+        return False
+    return _link_walk_ok(path, walk_base)
+
+
+def _package_scan_folder_options(argv, head, folder):
+    """(run_dir or None, refused_option_word or None) for npm, pnpm or yarn before a bare --."""
+    if head not in PACKAGE_FOLDER_LONG:
+        return None, None
+    base = folder or os.getcwd()
+    i, seen, run_dir, past_sub = 1, {}, None, False
+    while i < len(argv):
+        if argv[i] == "--":
+            break
+        word = argv[i]
+        if not word.startswith("-"):
+            past_sub = True
+            i += 1
+            continue
+        opt = _package_folder_token(head, word)
+        if opt == "attached":
+            return run_dir, word
+        if opt is not None:
+            long = opt
+            canon = PACKAGE_FOLDER_CANON[head].get(long, long)
+            value, nxt, shown = _package_folder_value(word, argv, i)
+            label = shown.split("=", 1)[0] if "=" in shown else shown
+            if canon in seen:
+                return run_dir, seen[canon]
+            seen[canon] = label
+            if value is None or not (value or "").strip():
+                return run_dir, label
+            if value.startswith("-"):
+                return run_dir, label
+            if not PACKAGE_FOLDER_VALUE_RE.fullmatch(value):
+                return run_dir, label
+            if not _package_folder_ok(value, base):
+                return run_dir, label
+            run_dir = os.path.abspath(value if os.path.isabs(value) else os.path.join(base, value))
+            i = nxt
+            continue
+        if past_sub and word in PACKAGE_ALLOWED_FLAGS:
+            i += 1
+            continue
+        return run_dir, word.split("=", 1)[0]
+    return run_dir, None
+
