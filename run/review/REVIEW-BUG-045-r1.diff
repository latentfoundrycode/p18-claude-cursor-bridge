+NO_VERIFY_ABBREVS = [("%s-%s" % (sub, prefix[2:]), _no_verify_abbrev_command(sub, prefix)) for sub in ("commit", "push", "merge", "rebase", "am", "cherry-pick", "revert") for prefix in _NO_VERIFY_PREFIXES]
