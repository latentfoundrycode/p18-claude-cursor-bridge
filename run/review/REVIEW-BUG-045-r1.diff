+    if sub == "merge":
+        return "git merge %s topic" % prefix
+    if sub == "rebase":
+        return "git rebase %s main" % prefix
+    if sub == "am":
+        return "git am %s mbox" % prefix
+    if sub == "cherry-pick":
+        return "git cherry-pick %s abc" % prefix
+    return "git revert %s HEAD" % prefix
+
