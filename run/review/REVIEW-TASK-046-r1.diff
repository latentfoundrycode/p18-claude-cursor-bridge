+def chain(levels):
+    lines, indent = [], ""
+    for i in range(levels - 1):
+        lines.append("%sk%d:" % (indent, i))
+        indent += "  "
+    lines.append("%sk%d: word" % (indent, levels - 1))
+    return lines
+
