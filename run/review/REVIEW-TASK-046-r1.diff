+FRAGMENTS = [
+    "a: word", "b: 1", "a:", "c:", "  b: x", "  c:", "    d: z", "  - p", "  - k: 1", "    j: 2", "  - k:", "      m: 1",
+    "- q", " e: 1", "   f: 1", "# note", "", "g: [x, 1]", 'h: "R&D"', "j:k",
