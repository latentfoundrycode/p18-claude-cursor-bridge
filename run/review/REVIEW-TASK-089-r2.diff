+    (r / "docs" / "BUILD_PLAN.md").write_text(plan, encoding="utf-8", newline="")
+    (r / "tests" / "test_parse.py").write_text("def test_it():  # R-001\n    assert True\n", encoding="utf-8")
+    hp.git(r, "init", "-q", "-b", "main")
+    hp.git(r, "add", "-A")
+    hp.git(r, "commit", "-q", "-m", "scratch")
+    return r
