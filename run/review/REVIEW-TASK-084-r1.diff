+CHECKPOINT_PATTERN = r"^\s*(?:[-*]\s+)?Merge unit:\s*((?:[A-Z][A-Za-z0-9-]*\s+)+[A-Z][A-Za-z0-9-]*)?\s*$"
+ID_FORM = "[A-Z][A-Za-z0-9-]*"
+BULLET_CLASS = "[-*]"
