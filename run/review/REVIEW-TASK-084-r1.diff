+    "field": header(("TASK-001",)) + body(ONE),
+    "line-null": header() + body(ONE),
+    "line-no-header": body(ONE),
+    "header-no-line": header(("TASK-001",)) + body(),
+    # refused by the rule: the other forms
+    "line-and-header-differ": header(("TASK-002",)) + body(ONE),
