#!/bin/sh
# Claude-Cursor Bridge: the cursor-agent shim for Claude Code's Bash tool on Windows.
# Installed by bridge-install.py at $LOCALAPPDATA/cursor-agent/cursor-agent from
# ~/.claude/cursor-bridge/cursor-agent.shim; bridge-check.py verifies the installed copy.
#
# It forwards every call to cursor-agent.cmd with the owner's identity withheld from the
# process (KP-032): the builder and the cross-family reviewer must never be able to post,
# approve, push or merge as the owner. Three things make that so:
#   - gh reads its login from GH_CONFIG_DIR, which points at an empty folder;
#   - no token variable reaches the agent;
#   - git has no credential helper for this process and never prompts, so a push or a
#     fetch from a private remote fails at once instead of using the owner's stored login.
# The agent still has everything it needs: the checkout on disk and Cursor's own account.
BRIDGE_GH_EMPTY="${LOCALAPPDATA:-$HOME/AppData/Local}/cursor-bridge/gh-empty"
mkdir -p "$BRIDGE_GH_EMPTY" 2>/dev/null
export GH_CONFIG_DIR="$BRIDGE_GH_EMPTY"
unset GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN
export GIT_TERMINAL_PROMPT=0
unset GIT_CONFIG_COUNT GIT_CONFIG_KEY_0 GIT_CONFIG_VALUE_0   # the helper is reset in the bridge's git config file below (2026.10.11c)
unset GIT_ASKPASS SSH_ASKPASS
# Every variable whose NAME looks like an account key is withheld too (2026.10.04e): the
# builder, and a reviewer that may execute code, must not inherit the owner's paid keys from
# the Windows user environment. The same test as bridge_env.SECRET_LIKE; Cursor's own
# variables and GIT_CONFIG_* are kept (the helper is reset through the bridge's git config file and GIT_CONFIG_PARAMETERS).
for BRIDGE_V in $(env | awk -F= '$1 ~ /^[A-Za-z_][A-Za-z0-9_]*$/ { u = toupper($1); if (u ~ /^CURSOR_/ || u ~ /^GIT_CONFIG_KEY_/) next; if (u ~ /(^|_)TOKENS?(_|$)/ || u ~ /(^|_)SECRETS?(_|$)/ || u ~ /PASSWORD|PASSWD|PASSPHRASE|CREDENTIAL|API_?KEY|ACCESS_?KEY|PRIVATE_?KEY/ || u ~ /_KEYS?$/) print $1 }'); do
  unset "$BRIDGE_V"
done
unset BRIDGE_V
# The run gets a home folder of its own (2026.10.06a, KP-038): cursor-agent imports the
# hooks of ~/.claude/settings.json and, under Git Bash, runs them in a way that denies every
# tool call; the owner's .ssh, .aws, .docker and other stores are then no longer found by
# default (not out of reach: the run is the owner's account). The folder holds a link
# `.cursor` to the owner's real ~/.cursor (the CLI's account and state) and nothing else;
# git keeps the owner's global configuration through GIT_CONFIG_GLOBAL, and the caches the
# builders' tools read by default are passed through by their own variables. The same
# recipe as bridge_env.agent_home and stripped_env: the link must exist, be a link and lead
# to the real ~/.cursor, or the run is refused rather than started into silent denial. The
# folder sits in the profile root: under AppData/Local a rename into such a link fails on
# the owner's computer.
BRIDGE_REAL_HOME="${USERPROFILE:-$HOME}"
BRIDGE_AGENT_HOME="$BRIDGE_REAL_HOME/.cursor-bridge/agent-home"
mkdir -p "$BRIDGE_AGENT_HOME" "$BRIDGE_REAL_HOME/.cursor" 2>/dev/null
if command -v cygpath >/dev/null 2>&1; then
  BRIDGE_AGENT_HOME_W="$(cygpath -w "$BRIDGE_AGENT_HOME")"
  BRIDGE_REAL_HOME_W="$(cygpath -w "$BRIDGE_REAL_HOME")"
else
  BRIDGE_AGENT_HOME_W="$BRIDGE_AGENT_HOME"
  BRIDGE_REAL_HOME_W="$BRIDGE_REAL_HOME"
fi
if [ ! -e "$BRIDGE_AGENT_HOME/.cursor" ]; then
  if command -v cmd >/dev/null 2>&1; then
    cmd //d //c mklink //J "$BRIDGE_AGENT_HOME_W\\.cursor" "$BRIDGE_REAL_HOME_W\\.cursor" >/dev/null 2>&1
  else
    ln -s "$BRIDGE_REAL_HOME/.cursor" "$BRIDGE_AGENT_HOME/.cursor" 2>/dev/null
  fi
fi
if [ "$(cd "$BRIDGE_AGENT_HOME/.cursor" 2>/dev/null && pwd -P)" != "$(cd "$BRIDGE_REAL_HOME/.cursor" 2>/dev/null && pwd -P)" ] || [ -z "$(cd "$BRIDGE_REAL_HOME/.cursor" 2>/dev/null && pwd -P)" ]; then
  echo "cursor-agent shim (Claude-Cursor Bridge): refused - $BRIDGE_AGENT_HOME_W/.cursor is not a link that leads to $BRIDGE_REAL_HOME_W/.cursor (KP-038); run the bridge's install again" >&2
  exit 125
fi
# The bridge's own global git config: includes the owner's when it exists and resets the
# credential helper list (an empty `helper =` resets it), the same text as bridge_env.write_gitconfig.
# Paths inside the file use forward slashes: git refuses a backslash path in a config line.
if command -v cygpath >/dev/null 2>&1; then BRIDGE_REAL_HOME_M="$(cygpath -m "$BRIDGE_REAL_HOME")"; else BRIDGE_REAL_HOME_M="$BRIDGE_REAL_HOME"; fi
BRIDGE_GITCONFIG="$BRIDGE_REAL_HOME/.cursor-bridge/gitconfig"
mkdir -p "$BRIDGE_REAL_HOME/.cursor-bridge" 2>/dev/null
if ! {
  printf '%s\n' "# written by the Claude-Cursor Bridge before every builder or reviewer run; do not edit"
  if [ -f "$BRIDGE_REAL_HOME/.gitconfig" ]; then printf '[include]\n\tpath = %s\n' "$BRIDGE_REAL_HOME_M/.gitconfig"; fi
  printf '[credential]\n\thelper =\n'
} > "$BRIDGE_GITCONFIG.tmp" 2>/dev/null || ! mv -f "$BRIDGE_GITCONFIG.tmp" "$BRIDGE_GITCONFIG" 2>/dev/null; then
  echo "cursor-agent shim (Claude-Cursor Bridge): refused - cannot write $BRIDGE_REAL_HOME_M/.cursor-bridge/gitconfig, which resets the credential helper for the run" >&2
  exit 125
fi
export GIT_CONFIG_GLOBAL="$BRIDGE_REAL_HOME_M/.cursor-bridge/gitconfig"
# Read last of all, after the checkout's own .git/config: a helper written there by a builder
# cannot re-enable the owner's stored login (an empty value resets the list; non-empty, so a
# wholesale environment restore keeps it).
export GIT_CONFIG_PARAMETERS="'credential.helper='"
unset BRIDGE_GITCONFIG BRIDGE_REAL_HOME_M
[ -z "$HF_HUB_CACHE" ] && [ -d "$BRIDGE_REAL_HOME/.cache/huggingface/hub" ] && export HF_HUB_CACHE="$BRIDGE_REAL_HOME_W/.cache/huggingface/hub"
[ -z "$TORCH_HOME" ] && [ -d "$BRIDGE_REAL_HOME/.cache/torch" ] && export TORCH_HOME="$BRIDGE_REAL_HOME_W/.cache/torch"
[ -z "$PUPPETEER_CACHE_DIR" ] && [ -d "$BRIDGE_REAL_HOME/.cache/puppeteer" ] && export PUPPETEER_CACHE_DIR="$BRIDGE_REAL_HOME_W/.cache/puppeteer"
# The run's own application folders (release S): APPDATA and LOCALAPPDATA name the agent
# home's skeleton, so a program the run starts writes its key file, cache or state there and
# never into the owner's real folders; the tools' package caches and the user's installed
# packages are passed through by their own variables first. The same recipe as
# bridge_env.APP_FOLDERS and APP_CACHES; each variable is set only where it was set.
mkdir -p "$BRIDGE_AGENT_HOME/AppData/Local" "$BRIDGE_AGENT_HOME/AppData/LocalLow" "$BRIDGE_AGENT_HOME/AppData/Roaming" \
  "$BRIDGE_AGENT_HOME/Documents" "$BRIDGE_AGENT_HOME/Desktop" "$BRIDGE_AGENT_HOME/Downloads" 2>/dev/null
bridge_pass() {   # <variable> <owner's folder> <relative path>: pass the owner's folder by the tool's own variable
  eval "BRIDGE_CUR=\${$1}"
  if [ -z "$BRIDGE_CUR" ] && [ -n "$2" ] && [ -d "$2/$3" ]; then
    if command -v cygpath >/dev/null 2>&1; then export "$1=$(cygpath -w "$2/$3")"; else export "$1=$2/$3"; fi
  fi
}
bridge_pass UV_CACHE_DIR "$LOCALAPPDATA" uv/cache
bridge_pass UV_PYTHON_INSTALL_DIR "$APPDATA" uv/python
bridge_pass PIP_CACHE_DIR "$LOCALAPPDATA" pip/Cache
bridge_pass PYTHONUSERBASE "$APPDATA" Python
bridge_pass NPM_CONFIG_CACHE "$LOCALAPPDATA" npm-cache
bridge_pass YARN_CACHE_FOLDER "$LOCALAPPDATA" Yarn/Cache
bridge_pass PLAYWRIGHT_BROWSERS_PATH "$LOCALAPPDATA" ms-playwright
bridge_pass GOCACHE "$LOCALAPPDATA" go-build
unset -f bridge_pass
unset BRIDGE_CUR
# cursor-agent reads its login under %APPDATA%/Cursor (probed 2026-11-11: logged out without
# it), so the skeleton's Roaming folder holds a link `Cursor` to the owner's, made here when
# missing, as `.cursor` above; the same recipe as bridge_env.APP_LINKS. Where the owner has
# the folder and the link is not one that leads to it, APPDATA keeps the owner's folder for
# this run: the login matters more than the redirect.
BRIDGE_ROAMING_OK=1
if [ -n "$APPDATA" ] && [ -d "$APPDATA/Cursor" ]; then
  BRIDGE_LINK="$BRIDGE_AGENT_HOME/AppData/Roaming/Cursor"
  if [ ! -e "$BRIDGE_LINK" ]; then
    if command -v cmd >/dev/null 2>&1 && command -v cygpath >/dev/null 2>&1; then
      cmd //d //c mklink //J "$(cygpath -w "$BRIDGE_LINK")" "$(cygpath -w "$APPDATA/Cursor")" >/dev/null 2>&1
    else
      ln -s "$APPDATA/Cursor" "$BRIDGE_LINK" 2>/dev/null
    fi
  fi
  if [ "$(cd "$BRIDGE_LINK" 2>/dev/null && pwd -P)" != "$(cd "$APPDATA/Cursor" 2>/dev/null && pwd -P)" ] || [ -z "$(cd "$APPDATA/Cursor" 2>/dev/null && pwd -P)" ]; then
    BRIDGE_ROAMING_OK=0
  fi
  unset BRIDGE_LINK
fi
if command -v cygpath >/dev/null 2>&1; then
  [ -n "$APPDATA" ] && [ "$BRIDGE_ROAMING_OK" = 1 ] && export APPDATA="$(cygpath -w "$BRIDGE_AGENT_HOME/AppData/Roaming")"
  [ -n "$LOCALAPPDATA" ] && export LOCALAPPDATA="$(cygpath -w "$BRIDGE_AGENT_HOME/AppData/Local")"
else
  [ -n "$APPDATA" ] && [ "$BRIDGE_ROAMING_OK" = 1 ] && export APPDATA="$BRIDGE_AGENT_HOME/AppData/Roaming"
  [ -n "$LOCALAPPDATA" ] && export LOCALAPPDATA="$BRIDGE_AGENT_HOME/AppData/Local"
fi
unset BRIDGE_ROAMING_OK
export HOME="$BRIDGE_AGENT_HOME_W" USERPROFILE="$BRIDGE_AGENT_HOME_W"
case "$BRIDGE_AGENT_HOME_W" in
  [A-Za-z]:*) export HOMEDRIVE="${BRIDGE_AGENT_HOME_W%%:*}:" HOMEPATH="${BRIDGE_AGENT_HOME_W#?:}" ;;
esac
unset BRIDGE_REAL_HOME BRIDGE_AGENT_HOME BRIDGE_REAL_HOME_W BRIDGE_AGENT_HOME_W
exec cursor-agent.cmd "$@"
